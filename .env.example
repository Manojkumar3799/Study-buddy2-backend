# --- App ---
APP_NAME=StudyForge AI
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# --- Upload ---
MAX_PDF_SIZE_MB=50

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Chunking ---
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=100

# --- Retrieval ---
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35

# --- LLM ---
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
GROK_API_KEY=your_grok_key_here

# --- Firecrawl MCP (web research) ---
# Get your free API key at https://firecrawl.dev
# Requires Node.js / npx to be installed (the MCP server runs via npx firecrawl-mcp)
# Leave empty to disable web research — PDF RAG will still work fully.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

GEMINI_MODEL=gemini/gemini-2.5-flash
GROQ_MODEL=groq/llama-3.3-70b-versatile
GROK_MODEL=xai/grok-2-latest

LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_REQUEST_TIMEOUT_SECONDS=30

# --- Supabase Storage (REST API — for PDF blob storage) ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=pdfs

# --- Supabase Database (direct Postgres — for pgvector similarity search) ---
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct tab
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres